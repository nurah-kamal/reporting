relationship 'Requests opened on'
	fromColumn: Requests.'Opened On'
	toColumn: Date.Date

relationship 'Requests closed on'
	isActive: false
	fromColumn: Requests.'Closed On'
	toColumn: Date.Date

relationship 'Requests category'
	fromColumn: Requests.Category
	toColumn: Category.Category

relationship 'Requests channel'
	fromColumn: Requests.Channel
	toColumn: Channel.Channel


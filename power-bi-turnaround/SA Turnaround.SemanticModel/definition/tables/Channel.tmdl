/// One row per channel.
table Channel
	lineageTag: cb95de56-4b05-4abb-9776-d03e30302676

	column Channel
		dataType: string
		lineageTag: 7ab03228-d866-4706-87b4-8a1c84e6e195
		summarizeBy: none
		sourceColumn: Channel
		sortByColumn: 'Channel Sort'

	/// Only the web form takes requests on weekends and public holidays.
	column 'Open When Desk Closed'
		dataType: boolean
		lineageTag: be14ffff-b337-454e-8edd-379063f807b2
		summarizeBy: none
		sourceColumn: Open When Desk Closed

	column 'Channel Sort'
		dataType: int64
		isHidden
		lineageTag: 695611f6-4d14-402f-a744-82104c2a18fe
		summarizeBy: none
		sourceColumn: Channel Sort

	partition Channel = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "channel.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Renamed = Table.RenameColumns(Promoted, {{"channel", "Channel"}, {"open_when_desk_closed", "Open When Desk Closed"}, {"sort_order", "Channel Sort"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Channel", type text}, {"Open When Desk Closed", Int64.Type}, {"Channel Sort", Int64.Type}}),
				    AsLogical = Table.TransformColumns(Typed, {{"Open When Desk Closed", each _ = 1, type logical}})
				in
				    AsLogical


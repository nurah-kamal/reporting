/// One row per service-desk request (synthetic). Closed On is blank while a request is still open on 31 Dec 2025.
table Requests
	lineageTag: f0d595a0-f412-45aa-9d8f-6ea5a294c29b

	/// Requests opened in the period.
	measure Requests = COUNTROWS ( Requests )
		formatString: #,0
		displayFolder: 1 Counts
		lineageTag: d42d5489-11c7-4c04-ac24-5cd447bee167

	/// Requests opened in the period that have closed. Every turnaround measure is over these.
	measure 'Closed Requests' = CALCULATE ( [Requests], NOT ISBLANK ( Requests[Closed On] ) )
		formatString: #,0
		displayFolder: 1 Counts
		lineageTag: a17f353f-8ee0-4973-b600-29506cbb5ff1

	/// Requests opened in the period and still open on 31 Dec 2025.
	measure 'Open Requests' = CALCULATE ( [Requests], ISBLANK ( Requests[Closed On] ) )
		formatString: #,0
		displayFolder: 1 Counts
		lineageTag: e02bc534-6912-41a5-aa1b-528047b07bd5

	/// Requests closed in the period, whenever they were opened. Switches on the inactive Closed On relationship.
	measure 'Closed in Period' = CALCULATE ( [Closed Requests], USERELATIONSHIP ( Requests[Closed On], 'Date'[Date] ) )
		formatString: #,0
		displayFolder: 1 Counts
		lineageTag: 157b1c74-2d4d-4b15-8e42-e3457899e0fc

	/// The backlog: requests opened by the last day of the period and not yet closed on that day.
	measure 'Open at Period End' =
			VAR _end = MAX ( 'Date'[Date] )
			RETURN
			    CALCULATE (
			        [Requests],
			        REMOVEFILTERS ( 'Date' ),
			        Requests[Opened On] <= _end,
			        ISBLANK ( Requests[Closed On] ) || Requests[Closed On] > _end
			    )
		formatString: #,0
		displayFolder: 1 Counts
		lineageTag: a8ac7e69-c8ba-4ef3-a140-9d1d743c01e9

	/// Weekdays in the period that are not public holidays.
	measure 'Working Days in Period' = CALCULATE ( COUNTROWS ( 'Date' ), 'Date'[Is Working Day] = TRUE () )
		formatString: #,0
		displayFolder: 1 Counts
		lineageTag: a9f2233d-c394-4e95-9cc5-f0f78c828730

	/// Middle turnaround of closed requests, counting every day.
	measure 'Median Calendar Days' = MEDIAN ( Requests[Calendar Days] )
		formatString: 0.0
		displayFolder: 2 Turnaround
		lineageTag: 48ed8667-c56c-4b00-8025-e3e775c0391b

	/// Middle turnaround of closed requests, counting working days only.
	measure 'Median Working Days' = MEDIAN ( Requests[Working Days] )
		formatString: 0.0
		displayFolder: 2 Turnaround
		lineageTag: 9436a50b-a4e2-4b21-bb6b-5dfb0952cfa3

	/// Mean turnaround of closed requests in working days. Pulled up by the few that wait on someone else; the median is the fairer headline.
	measure 'Average Working Days' = AVERAGE ( Requests[Working Days] )
		formatString: 0.00
		displayFolder: 2 Turnaround
		lineageTag: c9a78d3e-4b84-4b5f-a912-80d48448dedc

	/// Closed requests the spreadsheet measure calls late.
	measure 'Late by Calendar Days' = CALCULATE ( [Closed Requests], Requests[Late (Calendar Days)] = TRUE () )
		formatString: #,0
		displayFolder: 3 Late
		lineageTag: 10e160ec-e24d-4fb0-9cdc-25544437f782

	/// Closed requests that really were late: over target in working days.
	measure 'Late by Working Days' = CALCULATE ( [Closed Requests], Requests[Late (Working Days)] = TRUE () )
		formatString: #,0
		displayFolder: 3 Late
		lineageTag: f0717411-4110-4483-b3b6-66f0701c68a5

	/// Share of closed requests late by the spreadsheet measure.
	measure 'Late % (Calendar Days)' = DIVIDE ( [Late by Calendar Days], [Closed Requests] )
		formatString: 0.0%
		displayFolder: 3 Late
		lineageTag: cbfd93d6-1cb2-4b73-96d3-77ab2fb5b25b

	/// Share of closed requests late in working days.
	measure 'Late % (Working Days)' = DIVIDE ( [Late by Working Days], [Closed Requests] )
		formatString: 0.0%
		displayFolder: 3 Late
		lineageTag: a725bbd9-9110-48a1-b6fa-5f17212479d7

	/// Called late by the calendar measure but on time once public holidays are counted.
	measure 'Wrongly Late' =
			CALCULATE (
			    [Closed Requests],
			    Requests[Late (Calendar Days)] = TRUE (),
			    Requests[Late (Working Days)] = FALSE ()
			)
		formatString: #,0
		displayFolder: 4 Where they disagree
		lineageTag: 73a63040-9758-4cf4-b98d-e5954234063e

	/// Share of the calendar measure's late requests that were actually on time.
	measure 'Wrongly Late %' = DIVIDE ( [Wrongly Late], [Late by Calendar Days] )
		formatString: 0.0%
		displayFolder: 4 Where they disagree
		lineageTag: 0a95a3ae-e85a-44b2-ba5e-567dcc461227

	/// Really late in working days, but the calendar measure called them on time: its weekend stretch hands out extra days even when no weekend falls inside.
	measure 'Missed Late' =
			CALCULATE (
			    [Closed Requests],
			    Requests[Late (Working Days)] = TRUE (),
			    Requests[Late (Calendar Days)] = FALSE ()
			)
		formatString: #,0
		displayFolder: 4 Where they disagree
		lineageTag: 432046b0-6a30-47b4-b68f-5749f27a17ea

	/// How many percentage points the calendar measure overstates the late rate. Large in holiday months only.
	measure 'Late Gap (pts)' = ( [Late % (Calendar Days)] - [Late % (Working Days)] ) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: 4 Where they disagree
		lineageTag: 9804bef9-1662-4aa2-8932-8f2a3696ae27

	/// The working-day late rate for the same period a year earlier.
	measure 'Late % (Working Days) LY' = CALCULATE ( [Late % (Working Days)], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: 0.0%
		displayFolder: 5 Over time
		lineageTag: c8b7402a-85e1-4d2c-a972-b6ff93d0048f

	/// Change in the working-day late rate against the same period last year, in percentage points.
	measure 'Late % (Working Days) YoY (pts)' =
			IF (
			    NOT ISBLANK ( [Late % (Working Days) LY] ),
			    ( [Late % (Working Days)] - [Late % (Working Days) LY] ) * 100
			)
		formatString: +0.0;-0.0;0.0
		displayFolder: 5 Over time
		lineageTag: 524b7cd1-a2c9-4806-987d-057167250e2b

	/// The working-day late rate in the previous quarter.
	measure 'Late % (Working Days) PQ' = CALCULATE ( [Late % (Working Days)], DATEADD ( 'Date'[Date], -1, QUARTER ) )
		formatString: 0.0%
		displayFolder: 5 Over time
		lineageTag: 72d5a2f7-e471-40ba-962d-1d5b817fffe5

	/// Working-day late rate for refunds only, whatever category is selected. Shows the second sign-off from July 2025.
	measure 'Refund Late % (Working Days)' = CALCULATE ( [Late % (Working Days)], Category[Category] = "Refund" )
		formatString: 0.0%
		displayFolder: 5 Over time
		lineageTag: ed2e8e18-8e44-47cf-b887-61eb124b4d45

	/// Working-day late rate for every category except refunds, as the comparison line.
	measure 'Other Late % (Working Days)' = CALCULATE ( [Late % (Working Days)], Category[Category] <> "Refund" )
		formatString: 0.0%
		displayFolder: 5 Over time
		lineageTag: 669dc044-ce2e-44e4-9fe0-20f1511315cc

	/// Late % counted the way the Count Days As slicer says: working days unless Calendar days is picked.
	measure 'Late % (Chosen Count)' =
			SWITCH (
			    SELECTEDVALUE ( 'Count Days As'[Count Days As Order], 0 ),
			    1, [Late % (Calendar Days)],
			    [Late % (Working Days)]
			)
		formatString: 0.0%
		displayFolder: 3 Late
		lineageTag: c0a23b65-ef67-4a09-bd24-7789c1bed3ac

	column 'Request ID'
		dataType: string
		lineageTag: c06604ac-395d-4d79-96fe-84cc428ea8db
		summarizeBy: none
		sourceColumn: Request ID

	column 'Opened On'
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 69343500-978c-4350-a11f-58c72db4c4af
		summarizeBy: none
		sourceColumn: Opened On

		annotation UnderlyingDateTimeDataType = Date

	column 'Closed On'
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: e0f5ec2c-f01d-4b15-a82f-d51622ddef1e
		summarizeBy: none
		sourceColumn: Closed On

		annotation UnderlyingDateTimeDataType = Date

	column Channel
		dataType: string
		isHidden
		lineageTag: 011308cc-235d-4cbc-8685-6b04b60cbd4a
		summarizeBy: none
		sourceColumn: Channel

	column Category
		dataType: string
		isHidden
		lineageTag: 29844138-55f4-44ca-baa4-72aa726ef671
		summarizeBy: none
		sourceColumn: Category

	/// Days from opening to closing, counting every day, as a spreadsheet does by subtracting dates. Blank while open.
	column 'Calendar Days' = IF ( NOT ISBLANK ( Requests[Closed On] ), INT ( Requests[Closed On] - Requests[Opened On] ) )
		dataType: int64
		displayFolder: Turnaround
		lineageTag: 279c6c69-d44d-44ca-b7ad-c7af5f9821fe
		summarizeBy: none

	/// Working days after opening, up to and including closing: weekends and SA public holidays not counted. A subtraction of the running working-day index, so no day-by-day loop. Blank while open.
	column 'Working Days' =
			IF (
			    NOT ISBLANK ( Requests[Closed On] ),
			    LOOKUPVALUE ( 'Date'[Working Day Index], 'Date'[Date], Requests[Closed On] )
			        - RELATED ( 'Date'[Working Day Index] )
			)
		dataType: int64
		displayFolder: Turnaround
		lineageTag: a4641f35-f2b4-4e2c-b837-e8b9a3c0427a
		summarizeBy: none

	/// Public holidays falling on a weekday between opening and closing. Blank while open.
	column 'Weekday Holidays Inside' =
			IF (
			    NOT ISBLANK ( Requests[Closed On] ),
			    VAR _opened = Requests[Opened On]
			    VAR _closed = Requests[Closed On]
			    RETURN
			        COUNTROWS (
			            FILTER (
			                ALL ( 'Date' ),
			                'Date'[Date] > _opened
			                    && 'Date'[Date] <= _closed
			                    && NOT ISBLANK ( 'Date'[Holiday] )
			                    && 'Date'[Weekday No] <= 5
			            )
			        ) + 0
			)
		dataType: int64
		displayFolder: Turnaround
		lineageTag: cd84bd86-fd9f-491b-85e0-2d80fa89109f
		summarizeBy: none

	/// Late by the spreadsheet measure: calendar days over the weekend-stretched target.
	column 'Late (Calendar Days)' = IF ( NOT ISBLANK ( Requests[Closed On] ), Requests[Calendar Days] > RELATED ( Category[Calendar Target Days] ) )
		dataType: boolean
		displayFolder: Turnaround
		lineageTag: ddc6a8a4-7362-41fd-a8b1-4218513340db
		summarizeBy: none

	/// Late by the honest measure: working days over the target as written.
	column 'Late (Working Days)' = IF ( NOT ISBLANK ( Requests[Closed On] ), Requests[Working Days] > RELATED ( Category[Target Working Days] ) )
		dataType: boolean
		displayFolder: Turnaround
		lineageTag: 0c5d681f-7586-48f6-a045-602d27f973c5
		summarizeBy: none

	column 'Holiday Window' =
			SWITCH (
			    TRUE (),
			    ISBLANK ( Requests[Closed On] ), BLANK (),
			    Requests[Weekday Holidays Inside] = 0, "No holiday in the window",
			    Requests[Weekday Holidays Inside] = 1, "One holiday",
			    "Two or more"
			)
		dataType: string
		displayFolder: Turnaround
		lineageTag: ed043aa7-0667-4cc7-993a-7d0d2e1a03cf
		summarizeBy: none

	/// How the two measures agree on this request.
	column Verdict =
			VAR _cal = Requests[Late (Calendar Days)]
			VAR _wd = Requests[Late (Working Days)]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Requests[Closed On] ), "Still open",
			        _cal && _wd, "Late either way",
			        _cal, "Wrongly late (calendar only)",
			        _wd, "Missed (working days only)",
			        "On time either way"
			    )
		dataType: string
		displayFolder: Turnaround
		lineageTag: 6e66d4fb-2afb-451e-934b-78cb6e8b76ba
		summarizeBy: none

	partition Requests = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "requests.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"closed_on"}),
				    Kept = Table.SelectColumns(Blanks, {"request_id", "opened_on", "closed_on", "channel", "category"}),
				    Renamed = Table.RenameColumns(Kept, {{"request_id", "Request ID"}, {"opened_on", "Opened On"}, {"closed_on", "Closed On"}, {"channel", "Channel"}, {"category", "Category"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Request ID", type text}, {"Opened On", type date}, {"Closed On", type date}, {"Channel", type text}, {"Category", type text}}, "en-ZA")
				in
				    Typed


/// One row per day, 2023 to 2025, with South African public holidays and a running count of working days.
table Date
	lineageTag: 975d2d8e-9544-42b6-a1b8-cc59bfd841f4
	dataCategory: Time

	column Date
		dataType: dateTime
		isUnique
		isKey
		formatString: yyyy-mm-dd
		lineageTag: 8d4551d4-dee0-4ac9-b51a-d0949ed6aa11
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		lineageTag: 84a7dfee-de5b-454d-8a7f-829e07caa2d9
		summarizeBy: none
		sourceColumn: Year

	/// Year and quarter, e.g. 2025-Q3.
	column Quarter
		dataType: string
		lineageTag: 61d4e22e-d0a0-4122-8a95-a7a83213792b
		summarizeBy: none
		sourceColumn: Quarter

	column 'Month No'
		dataType: int64
		isHidden
		lineageTag: 060be78f-6b1a-4459-8e1a-d343234c82c3
		summarizeBy: none
		sourceColumn: Month No

	column Month
		dataType: string
		lineageTag: 91f4268c-521e-422a-bce2-0b5537f89040
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: 'Month No'

	/// e.g. 2025-07; sorts correctly as text.
	column 'Year Month'
		dataType: string
		lineageTag: 7fd60ac5-51ad-49f3-8aa6-cf9888b22332
		summarizeBy: none
		sourceColumn: Year Month

	column 'Weekday No'
		dataType: int64
		isHidden
		lineageTag: 9a221223-7a1e-4b3c-b568-85beec6c4a53
		summarizeBy: none
		sourceColumn: Weekday No

	column Weekday
		dataType: string
		lineageTag: de7d62cc-1610-4c79-b9b4-62dc217b789b
		summarizeBy: none
		sourceColumn: Weekday
		sortByColumn: 'Weekday No'

	column 'Is Weekend'
		dataType: boolean
		lineageTag: 245c885d-61e9-4af7-9420-d5a6b6bfae97
		summarizeBy: none
		sourceColumn: Is Weekend

	/// Public holiday name; blank on an ordinary day.
	column Holiday
		dataType: string
		lineageTag: 79bda167-09c1-4987-af00-e76fb29bee54
		summarizeBy: none
		sourceColumn: Holiday

	/// statutory, sunday-rule (the Monday after a Sunday holiday) or declared (a one-off day the President declared).
	column 'Holiday Kind'
		dataType: string
		lineageTag: 9c49a7b5-cac3-41b5-9f7e-ee9e7c064abb
		summarizeBy: none
		sourceColumn: Holiday Kind

	/// Monday to Friday and not a public holiday.
	column 'Is Working Day'
		dataType: boolean
		lineageTag: 4ff0f95d-4e20-42c6-8383-c8911bc2f5d6
		summarizeBy: none
		sourceColumn: Is Working Day

	/// Running count of working days since 1 Jan 2023. Working days from a to b = index(b) - index(a).
	column 'Working Day Index'
		dataType: int64
		isHidden
		lineageTag: 9a1720b0-62e9-45cd-9577-1dc92c31f3cc
		summarizeBy: none
		sourceColumn: Working Day Index

	partition Date = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "calendar.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"holiday_name", "holiday_kind"}),
				    Renamed = Table.RenameColumns(Blanks, {{"date", "Date"}, {"year", "Year"}, {"quarter", "Quarter"}, {"month_no", "Month No"}, {"month", "Month"}, {"year_month", "Year Month"}, {"weekday_no", "Weekday No"}, {"weekday", "Weekday"}, {"is_weekend", "Is Weekend"}, {"holiday_name", "Holiday"}, {"holiday_kind", "Holiday Kind"}, {"is_working_day", "Is Working Day"}, {"working_day_index", "Working Day Index"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Date", type date}, {"Year", Int64.Type}, {"Quarter", type text}, {"Month No", Int64.Type}, {"Month", type text}, {"Year Month", type text}, {"Weekday No", Int64.Type}, {"Weekday", type text}, {"Is Weekend", Int64.Type}, {"Holiday", type text}, {"Holiday Kind", type text}, {"Is Working Day", Int64.Type}, {"Working Day Index", Int64.Type}}, "en-ZA"),
				    AsLogical = Table.TransformColumns(Typed, {{"Is Weekend", each _ = 1, type logical}, {"Is Working Day", each _ = 1, type logical}})
				in
				    AsLogical

